{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node herramientas/vercel-build.js",
  "outputDirectory": "estatico",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server,src,contenido,herramientas,public}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "headers": [
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
