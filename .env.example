# ======================================================================
# Sitio web — Ilustre Municipalidad de Melipeuco
# Copie este archivo como .env y complete los valores.
# ======================================================================

# ---- Servidor ----
PORT=8090
# URL pública del sitio (con / final). Con https:// se activan las cookies seguras y HSTS.
PUBLIC_URL=https://municipalidadmelipeuco.cl/
DATA_DIR=./data
# Número de proxies inversos de confianza delante del servidor (nginx = 1).
TRUST_PROXY=1
# LOG_REQUESTS=1

# ---- Primer arranque: Super Administrador ----
ADMIN_EMAIL=informatica@munimelipeuco.cl
# Si se deja vacío se genera una contraseña temporal y se muestra UNA vez en la consola.
ADMIN_PASSWORD=

# ---- Plataforma Municipal de Trámites (proyecto «Transito») ----
# URL pública de la plataforma (con / final). Con ella el sitio muestra en vivo el catálogo de
# trámites en línea, las próximas horas disponibles, el seguimiento y la verificación de documentos.
TRAMITES_URL=https://tramites.municipalidadmelipeuco.cl/
# Llave API de la plataforma (Intranet → Administración → Llaves API) con alcance
# «solicitudes.crear»: los mensajes de OIRS del sitio entran como solicitudes a la Oficina de Partes.
TRAMITES_API_KEY=
# Código del trámite de la plataforma que recibe las solicitudes OIRS del sitio.
TRAMITES_OIRS_CODIGO=SEC-OIRS-01
# Orígenes que pueden leer la API pública del sitio (noticias, avisos, eventos) desde el navegador.
CORS_ORIGINS=https://tramites.municipalidadmelipeuco.cl

# ---- Medios heredados de WordPress ----
# Mientras los archivos de /wp-content/uploads/ no estén copiados en DATA_DIR/uploads/wp,
# el sitio redirige a esta dirección (p. ej. el WordPress antiguo en otro subdominio).
MEDIOS_RESPALDO_URL=https://municipalidadmelipeuco.cl/

# ---- Correo (notificaciones de formularios y boletín) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Municipalidad de Melipeuco <no-responder@munimelipeuco.cl>
# Correo que recibe copia de los mensajes de contacto/OIRS
AVISOS_EMAIL=oficinadepartes@munimelipeuco.cl

# ---- Respaldos ----
BACKUP_KEEP=14
# Clave para cifrar los respaldos (AES-256-GCM). Guárdela fuera del servidor.
BACKUP_KEY=

# ---- Datos de demostración ----
# DEMO=1  # crea usuarios de prueba (NO usar en producción)
